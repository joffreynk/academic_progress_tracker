# ==============================================================================
# STUDENT ACADEMIC & BEHAVIOURAL REPORTING PLATFORM - ENVIRONMENT CONFIGURATION
# Reference: Section 180 of student.md specification
# ==============================================================================

# Local SQLite file for development; Wrangler D1 binding is used in Cloudflare deployments.
DATABASE_URL=./.data/local.db

# Wrangler D1 binding name used in Cloudflare deployment
DB=DB

# Application Base URL
APP_URL=http://localhost:3000

# Secret key for session hashing and cryptographic tokens
AUTH_SECRET=

# Initial Super Admin Provisioning (Used during first-run initialization)
SUPER_ADMIN_INITIAL_EMAIL=super@demo.school
SUPER_ADMIN_INITIAL_USERNAME=demo.super

# One-time setup token for initial deployment bootstrap (prior to first super admin setup)
SETUP_TOKEN=

# Development seed password (Minimum 12 characters; used only in local development / seed scripts)
DEMO_PASSWORD=
