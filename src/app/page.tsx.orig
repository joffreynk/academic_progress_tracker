'use client';
import { useEffect, useMemo, useState } from 'react';
import { LayoutDashboard, ClipboardList, FilePlus2, GraduationCap, Users, BookOpen, CalendarDays, Settings, ShieldCheck, LogOut, Search, ChevronRight, Plus, Check, Clock3, AlertCircle, BarChart3, School, Download, Printer, Menu, X, ArrowLeft, RefreshCw, LockKeyhole, Layers3, UserRound, CheckCircle2 } from 'lucide-react';
import type ExcelJS from 'exceljs';
import MonthlyOverview from './MonthlyOverview';
import type { Observation, Rules } from '@/lib/reporting';

type User={id:string;name:string;role:string;organizationId:string|null};
type Assignment={id:string;classId:string;className:string;subjectId:string;subjectName:string;academicYearId:string;yearName:string;teacherName:string};
type Student={id:string;studentId:string;fullName:string;classId:string;gradeId:string;academicYearId:string;status:string;className:string};
type Ref={years:{id:string;name:string;startDate:string;endDate:string}[];terms:{id:string;name:string;academicYearId:string;startDate:string;endDate:string}[];grades:{id:string;name:string;orderIndex:number}[];classes:{id:string;name:string;gradeId:string;academicYearId:string}[];subjects:{id:string;name:string;code:string}[];teachers:{id:string;name:string;email:string;teacherId:string;active:boolean}[];assignments:{id:string;teacherId:string;classId:string;subjectId:string;academicYearId:string}[];today:string;minDate:string;organization:{name:string;timezone:string}};
type Report={id:string;lessonDate:string;topic:string;status:string;classId:string;subjectId:string;className:string;subjectName:string;teacherName:string;updatedAt:string;reviewComment:string|null};
type Row={studentId:string;attendanceStatus:'PRESENT'|'LATE'|'ABSENT';performance:string|null;participation:string|null;homework:string|null;conduct:string|null;comment:string};
type Summary={studentId:string;studentName:string;studentCode:string;className:string;subjectName:string;lessons:number;attendance:Record<string,number>;performance:Record<string,number>;participation:Record<string,number>;homework:Record<string,number>;conduct:Record<string,number>;attendanceRate:number|null;performanceResult:string;participationResult:string;homeworkResult:string;conductResult:string;punctualityResult:string;topics:string[];observations:{date:string;comment:string;subject:string}[];version:number};
const normal=(studentId:string):Row=>({studentId,attendanceStatus:'PRESENT',performance:'GOOD',participation:'ACTIVE',homework:'COMPLETED',conduct:'GOOD',comment:''});
const label=(s:string)=>s.replaceAll('_',' ').toLowerCase().replace(/\b\w/g,c=>c.toUpperCase());
const fmt=(date:string)=>{try{return new Date(`${date.slice(0,10)}T12:00:00`).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});}catch{return date}};
async function api(view:string,params:Record<string,string>={}){const q=new URLSearchParams({view,...params});const r=await fetch(`/api/app?${q}`,{cache:'no-store'});const d=await r.json();if(!r.ok)throw Error(d.error||'Request failed');return d;}
async function post(action:string,data:unknown,extra:Record<string,unknown>={}){const r=await fetch('/api/app',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,data,...extra})});const d=await r.json();if(!r.ok)throw Error(d.error||'Request failed');return d;}
function Badge({status}:{status:string}){return <span className={`badge badge-${status.toLowerCase().replaceAll('_','-')}`}>{label(status)}</span>}
function Empty({title,detail}:{title:string;detail:string}){return <div className="empty"><div className="empty-icon"><Layers3 size={25}/></div><strong>{title}</strong><p>{detail}</p></div>}

export default function Home(){
 const [user,setUser]=useState<User|null|undefined>(undefined);const [login,setLogin]=useState({identity:'',password:''});const [setup,setSetup]=useState(false);const [setupFields,setSetupFields]=useState({setupToken:'',name:'',username:'',email:'',password:''});const [page,setPage]=useState('overview');const [busy,setBusy]=useState(false);const [error,setError]=useState('');const [notice,setNotice]=useState('');const [mobile,setMobile]=useState(false);
 const [overview,setOverview]=useState<{organization:string;today:string;minDate:string;counts:{students:number;teachers:number;classes:number;subjects:number;reports:Record<string,number>};assignments:Assignment[];recent:Report[];organizations?:number}|null>(null);
 const [ref,setRef]=useState<Ref|null>(null);const [students,setStudents]=useState<Student[]>([]);const [reports,setReports]=useState<Report[]>([]);const [organizations,setOrganizations]=useState<{id:string;name:string;code:string;timezone:string;active:boolean;studentCount:number;teacherCount:number;classCount:number;primaryAdminUserId:string|null}[]>([]);
 const [selectedClass,setSelectedClass]=useState('');const [selectedSubject,setSelectedSubject]=useState('');const [date,setDate]=useState('');const [topic,setTopic]=useState('');const [lessonId,setLessonId]=useState('');const [rows,setRows]=useState<Record<string,Row>>({});const [existingStatus,setExistingStatus]=useState('');const [search,setSearch]=useState('');const [studentPage,setStudentPage]=useState(0);const [studentsHasMore,setStudentsHasMore]=useState(false);const [studentProfile,setStudentProfile]=useState<{student:{id:string;fullName:string;studentId:string;className:string;status:string};timeline:{lessonDate:string;subject:string;topic:string;attendance:string;performance:string|null;participation:string|null;homework:string|null;conduct:string|null;comment:string|null;status:string}[];significant:{id:string;date:string;category:string;severity:string;description:string;actionTaken:string|null;followUpRequired:boolean}[]}|null>(null);const [entity,setEntity]=useState('student');const [form,setForm]=useState<Record<string,string>>({});const [monthlyMonth,setMonthlyMonth]=useState('');const [monthlyClass,setMonthlyClass]=useState('');const [monthlySubject,setMonthlySubject]=useState('');const [monthlyStudent,setMonthlyStudent]=useState('');const [monthlyYear,setMonthlyYear]=useState('');const [monthlyTerm,setMonthlyTerm]=useState('');const [monthlyGrade,setMonthlyGrade]=useState('');const [monthlyTeacher,setMonthlyTeacher]=useState('');const [monthly,setMonthly]=useState<{summaries:Summary[];data:Observation[];rules:Rules;organization:string;month:string;coverage:{observations:number;lessonReports:number;students:number};filters:{classId:string;subjectId:string}}|null>(null);const [selectedSummary,setSelectedSummary]=useState<Summary|null>(null);const [reviewDetail,setReviewDetail]=useState<{lesson:{id:string;topic:string;lessonDate:string;status:string;classId:string};records:(Row&{studentName?:string;studentCode?:string})[]}|null>(null);const [classStudents,setClassStudents]=useState<Student[]>([]);const [auditLogs,setAuditLogs]=useState<{id:string;action:string;entityType:string;createdAt:string;entityId:string}[]>([]);const [config,setConfig]=useState<{settings:{excellentThreshold:number;goodThreshold:number;homeworkUsuallyThreshold:number;punctualityOccasionallyMax:number;version:number};closures:{month:string;closed:boolean}[];organization:{timezone:string}}|null>(null);const [pass,setPass]=useState({current:'',password:''});const [importKind,setImportKind]=useState<'students'|'teachers'|'assignments'>('students');const [importRows,setImportRows]=useState<Record<string,string>[]>([]);const [importHeaders,setImportHeaders]=useState<string[]>([]);const [mapping,setMapping]=useState<Record<string,string>>({});const [importResult,setImportResult]=useState<{imported:number;updated:number;skipped:number;errors:{row:number;reason:string}[];credentials:{email:string;password:string}[]}|null>(null);
 const refresh=async()=>{const [o,r]=await Promise.all([api('overview'),api('reference').catch(()=>null)]);setOverview(o);if(r){setRef(r);setDate(d=>d||r.today);setMonthlyMonth(m=>m||r.today.slice(0,7));}};
 useEffect(()=>{fetch('/api/auth').then(r=>r.json()).then(d=>setUser(d.user)).catch(()=>setUser(null));},[]);
 useEffect(()=>{if(!user)return;api('overview').then(setOverview).catch(e=>setError(e.message));api('reference').then(r=>{if(r){setRef(r);setDate(d=>d||r.today);setMonthlyMonth(m=>m||r.today.slice(0,7));}}).catch(()=>null);},[user]);
 useEffect(()=>{if(!user)return;if(page==='reports')api('reports').then(d=>setReports(d.reports)).catch(e=>setError(e.message));if(page==='students' && (user.role==='ADMIN'||selectedClass))api('students',{...(selectedClass?{classId:selectedClass}:{}),...(search?{search}:{}),page:String(studentPage)}).then(d=>{setStudents(d.students);setStudentsHasMore(d.hasMore)}).catch(e=>setError(e.message));if(page==='organizations')api('organizations').then(d=>setOrganizations(d.organizations)).catch(e=>setError(e.message));if(page==='audit')api('audit').then(d=>setAuditLogs(d.logs)).catch(e=>setError(e.message));if(page==='settings'&&user.role==='ADMIN')api('settings').then(setConfig).catch(e=>setError(e.message));},[page,user,selectedClass,search,studentPage]);
 useEffect(()=>{if(page==='new'&&selectedClass&&ref){api('students',{classId:selectedClass,roster:'1'}).then(d=>{setStudents(d.students);setRows(prev=>Object.fromEntries((d.students as Student[]).map(s=>[s.id,prev[s.id]||normal(s.id)])));}).catch(e=>setError(e.message));}},[page,selectedClass,ref]);
 const navigate=(p:string)=>{setPage(p);setMobile(false);setError('');setNotice('');};
 const run=async(fn:()=>Promise<void>)=>{setBusy(true);setError('');setNotice('');try{await fn()}catch(e){setError(e instanceof Error?e.message:'Something went wrong.')}finally{setBusy(false)}};
 const loginSubmit=()=>run(async()=>{const r=await fetch('/api/auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(setup?{action:'setup',...setupFields}:{action:'login',...login})});const d=await r.json();if(!r.ok)throw Error(d.error);const x=await fetch('/api/auth').then(r=>r.json());setUser(x.user);navigate('overview')});
 const logout=()=>run(async()=>{await fetch('/api/auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'logout'})});setUser(null);navigate('overview')});
 const assignmentOptions=(overview?.assignments||[]).filter(a=>a.classId===selectedClass);
 const activeAssignment=(overview?.assignments||[]).find(a=>a.classId===selectedClass&&a.subjectId===selectedSubject);
 const teacherClasses=[...new Map((overview?.assignments||[]).map(a=>[a.classId,a])).values()];
 const startNew=(cl?:string,sub?:string)=>{setLessonId('');setExistingStatus('');setTopic('');setSelectedClass(cl||'');setSelectedSubject(sub||'');setDate(ref?.today||'');setRows({});navigate('new')};
 const openLesson=(id:string)=>run(async()=>{const d=await api('lesson',{id});setLessonId(d.lesson.id);setSelectedClass(d.lesson.classId);setSelectedSubject(d.lesson.subjectId);setDate(d.lesson.lessonDate);setTopic(d.lesson.topic);setExistingStatus(d.lesson.status);setRows(Object.fromEntries((d.records as Row[]).map(r=>[r.studentId,{...r,comment:r.comment||''}])));navigate('new')});
 const save=(submit:boolean)=>run(async()=>{if(!activeAssignment)throw Error('Select an assigned class and subject.');const payload={id:lessonId||undefined,classId:selectedClass,subjectId:selectedSubject,academicYearId:activeAssignment.academicYearId,lessonDate:date,topic,submit,records:students.filter(s=>rows[s.id]).map(s=>rows[s.id])};if(submit&&!window.confirm(`Submit ${activeAssignment.className} · ${activeAssignment.subjectName} on ${fmt(date)}?\n\nStudents: ${students.length}\nPresent: ${Object.values(rows).filter(r=>r.attendanceStatus==='PRESENT').length}\nLate: ${Object.values(rows).filter(r=>r.attendanceStatus==='LATE').length}\nAbsent: ${Object.values(rows).filter(r=>r.attendanceStatus==='ABSENT').length}`))return;const d=await post('saveLesson',payload);setLessonId(d.lesson.id);setExistingStatus(d.lesson.status);setNotice(submit?'Class report submitted successfully.':'Draft saved successfully.');await refresh();});
 const changeRow=(id:string,key:keyof Row,value:string)=>setRows(prev=>{const old=prev[id]||normal(id);const next={...old,[key]:value};if(key==='attendanceStatus'&&value==='ABSENT')return {...prev,[id]:{...next,performance:null,participation:null,homework:null,conduct:null}};if(key==='attendanceStatus'&&old.attendanceStatus==='ABSENT')return {...prev,[id]:{...normal(id),attendanceStatus:value as Row['attendanceStatus'],comment:old.comment}};return {...prev,[id]:next};});
 const getMonthly=()=>run(async()=>{const p:Record<string,string>={month:monthlyMonth};if(monthlyClass)p.classId=monthlyClass;if(monthlySubject)p.subjectId=monthlySubject;if(monthlyStudent)p.studentId=monthlyStudent;if(user?.role==='ADMIN'){if(monthlyYear)p.academicYearId=monthlyYear;if(monthlyTerm)p.termId=monthlyTerm;if(monthlyGrade)p.gradeId=monthlyGrade;if(monthlyTeacher)p.teacherId=monthlyTeacher}const d=await api('monthly',p);setMonthly({...d,filters:{classId:monthlyClass,subjectId:monthlySubject}});setSelectedSummary(null)});
 const exportMonthly=async(format:'csv'|'xlsx')=>{if(!monthly)return;try{await post('export',{month:monthly.month,classId:monthly.filters.classId||undefined,subjectId:monthly.filters.subjectId||undefined,format})}catch(e){setError(e instanceof Error?e.message:'Export access denied.');return}const data=monthly.summaries.map(s=>({Student:s.studentName,'Student ID':s.studentCode,Class:s.className,Subject:s.subjectName,Lessons:s.lessons,Present:s.attendance.PRESENT||0,Late:s.attendance.LATE||0,Absent:s.attendance.ABSENT||0,'Attendance %':s.attendanceRate,Performance:label(s.performanceResult),Participation:label(s.participationResult),Homework:s.homeworkResult,Conduct:label(s.conductResult),Topics:s.topics.join('; ')}));const headers=Object.keys(data[0]||{Student:'',Subject:''});let blob:Blob;if(format==='csv'){const safe=(v:unknown)=>{const s=String(v??'');return `"${(/^[=+@-]/.test(s)?"'":'')+s.replaceAll('"','""')}"`};blob=new Blob([[headers.join(','),...data.map(row=>headers.map(h=>safe(row[h as keyof typeof row])).join(','))].join('\r\n')],{type:'text/csv;charset=utf-8'});}else{const Excel=(await import('exceljs')).default as typeof ExcelJS;const book=new Excel.Workbook();const sheet=book.addWorksheet('Monthly report');sheet.columns=headers.map(h=>({header:h,key:h,width:Math.max(15,h.length+4)}));data.forEach(row=>sheet.addRow(row));sheet.getRow(1).font={bold:true,color:{argb:'FFFFFFFF'}};sheet.getRow(1).fill={type:'pattern',pattern:'solid',fgColor:{argb:'FF176B70'}};sheet.autoFilter={from:'A1',to:`${String.fromCharCode(64+headers.length)}1`};const buffer=await book.xlsx.writeBuffer();blob=new Blob([buffer as BlobPart],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});}const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`monthly-report-${monthlyMonth}.${format}`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};
 const create=()=>run(async()=>{await post('create',form,{type:entity});setForm({});setNotice(`${label(entity)} created successfully.`);await refresh();if(page==='students')setStudents((await api('students')).students)});
 const review=(id:string,status:string)=>run(async()=>{const comment=['RETURNED','SUBMITTED'].includes(status)?window.prompt(status==='RETURNED'?'Reason for returning this report:':'Reason for reopening this approved report:'):undefined;if(['RETURNED','SUBMITTED'].includes(status)&&!comment)return;await post('review',{id,status,comment});setReviewDetail(null);setNotice(status==='SUBMITTED'?'Approved report reopened for correction.':`Report ${label(status).toLowerCase()}.`);setReports((await api('reports')).reports);await refresh()});
 const parseImport=async(file:File)=>run(async()=>{if(file.size>2_000_000)throw Error('File must be under 2 MB.');if(!/\.(csv|xlsx)$/i.test(file.name))throw Error('Choose a CSV or XLSX file.');let table:string[][]=[];if(file.name.toLowerCase().endsWith('.csv')){const text=await file.text();let cell='',row:string[]=[],quoted=false;for(let i=0;i<text.length;i++){const ch=text[i];if(ch==='"'){if(quoted&&text[i+1]==='"'){cell+='"';i++}else quoted=!quoted}else if(ch===','&&!quoted){row.push(cell);cell=''}else if((ch==='\n'||ch==='\r')&&!quoted){if(ch==='\r'&&text[i+1]==='\n')i++;row.push(cell);if(row.some(v=>v.trim()))table.push(row);row=[];cell=''}else cell+=ch}row.push(cell);if(row.some(v=>v.trim()))table.push(row);}else{const Excel=(await import('exceljs')).default as typeof ExcelJS;const book=new Excel.Workbook();await book.xlsx.load(await file.arrayBuffer() as never);const sheet=book.worksheets[0];if(!sheet)throw Error('Workbook has no worksheet.');sheet.eachRow(row=>table.push((row.values as ExcelJS.CellValue[]).slice(1).map(v=>String(v??''))));}if(table.length<2)throw Error('File needs a header row and at least one data row.');if(table.length>301)throw Error('Maximum 300 data rows per import.');const headers=table[0].map(x=>x.trim());setImportHeaders(headers);setMapping(Object.fromEntries(importFields[importKind].map(k=>[k,headers.find(h=>h.toLowerCase()===k.toLowerCase())||''])));setImportRows(table.slice(1).map(row=>Object.fromEntries(headers.map((h,i)=>[h,row[i]?.trim()||'']))));setImportResult(null);});
 const confirmImport=()=>run(async()=>{const required=importFields[importKind].filter(k=>!['Status','Department','Active'].includes(k));if(required.some(k=>!mapping[k]))throw Error('Map all required columns before importing.');if(!window.confirm(`Import ${importRows.length} ${importKind} rows? Records will be validated against your school.`))return;const rows=importRows.map(r=>Object.fromEntries(importFields[importKind].map(k=>[k,r[mapping[k]]||''])));const result=await post('import',{kind:importKind,rows});setImportResult(result);setNotice(`Import complete: ${result.imported} imported, ${result.updated} updated, ${result.skipped} errors.`);await refresh()});
 const downloadErrors=()=>{if(!importResult)return;const text=['Row,Reason',...importResult.errors.map(e=>`${e.row},"${e.reason.replaceAll('"','""')}"`)].join('\r\n');const url=URL.createObjectURL(new Blob([text],{type:'text/csv'}));const a=document.createElement('a');a.href=url;a.download='import-errors.csv';a.click();URL.revokeObjectURL(url)};
 const nav=[{id:'overview',icon:LayoutDashboard,title:'Overview'},{id:'new',icon:FilePlus2,title:'New report'},{id:'reports',icon:ClipboardList,title:user?.role==='TEACHER'?'My reports':'Daily reports'},{id:'monthly',icon:BarChart3,title:'Monthly reports'},{id:'students',icon:GraduationCap,title:'Students'},...(user?.role==='ADMIN'?[{id:'statistics',icon:BarChart3,title:'Statistics'},{id:'manage',icon:Layers3,title:'School setup'},{id:'import',icon:Download,title:'Data import'},{id:'settings',icon:Settings,title:'Settings'},{id:'audit',icon:ShieldCheck,title:'Audit log'}]:[]),...(user?.role==='SUPER_ADMIN'?[{id:'organizations',icon:School,title:'Organizations'},{id:'audit',icon:ShieldCheck,title:'Global audit log'}]:[])];
 if(user===undefined)return <div className="loading-page"><div className="spinner"/>Loading your workspace...</div>;
 if(!user)return <div className="auth-wrap"><div className="auth-visual"><div className="auth-brand"><span className="brand-mark"><GraduationCap size={26}/></span><span>well<span className="brand-light">spring</span><small>EDUCATION PLATFORM</small></span></div><div className="auth-message"><div className="eyebrow light">A BETTER WAY TO SEE THE WHOLE PICTURE</div><h1>Every day matters.<br/><em>Every student counts.</em></h1><p>A thoughtful space for daily classroom observations and meaningful monthly insights.</p><div className="auth-features"><div><CheckCircle2 size={18}/> Simple daily reporting</div><div><CheckCircle2 size={18}/> Clear student progress</div><div><CheckCircle2 size={18}/> Secure school-wide insights</div></div></div><div className="auth-foot">Built for the people who make learning happen.</div></div><div className="auth-panel"><div className="login-card"><div className="mobile-brand"><GraduationCap/> wellspring</div><div className="login-icon"><LockKeyhole size={25}/></div><div className="eyebrow">WELCOME TO WELLSPRING</div><h2>{setup?'Set up your workspace':'Welcome back'}</h2><p className="muted">{setup?'Initialize your super administrator account.':'Sign in to continue to your school workspace.'}</p><form onSubmit={e=>{e.preventDefault();loginSubmit()}} className="login-form">{setup?<><label>Setup token<input required type="password" value={setupFields.setupToken} onChange={e=>setSetupFields({...setupFields,setupToken:e.target.value})}/></label><label>Full name<input required value={setupFields.name} onChange={e=>setSetupFields({...setupFields,name:e.target.value})}/></label><label>Username<input required value={setupFields.username} onChange={e=>setSetupFields({...setupFields,username:e.target.value})}/></label><label>Email<input required type="email" value={setupFields.email} onChange={e=>setSetupFields({...setupFields,email:e.target.value})}/></label></>:<label>Email or username<input required autoComplete="username" placeholder="you@school.org" value={login.identity} onChange={e=>setLogin({...login,identity:e.target.value})}/></label>}<label>Password<input required type="password" autoComplete={setup?'new-password':'current-password'} placeholder="Enter your password" value={setup?setupFields.password:login.password} onChange={e=>setup?setSetupFields({...setupFields,password:e.target.value}):setLogin({...login,password:e.target.value})}/></label>{error&&<div className="message error"><AlertCircle size={17}/>{error}</div>}<button className="btn primary wide" disabled={busy}>{busy?'Please wait...':setup?'Initialize workspace':'Sign in'} <ChevronRight size={18}/></button></form><button className="text-button" onClick={()=>{setSetup(!setup);setError('')}}>{setup?'Back to sign in':'First-time setup'}</button><p className="login-footer">Protected school information · Authorized access only</p></div></div></div>;
 const title=({overview:'Overview',new:'Daily class report',reports:'Daily reports',monthly:'Monthly reports',statistics:'Statistics',students:'Students',manage:'School setup',import:'Data import',settings:'Settings',audit:'Audit log',organizations:'Organizations'} as Record<string,string>)[page]||'Workspace';
 return <div className="app-shell"><aside className={`sidebar ${mobile?'sidebar-open':''}`}><div className="sidebar-top"><div className="sidebar-brand"><span className="brand-mark"><GraduationCap size={23}/></span><span>well<span className="brand-light">spring</span><small>EDUCATION PLATFORM</small></span></div><button className="close-mobile" onClick={()=>setMobile(false)}><X size={20}/></button></div><div className="workspace-label">WORKSPACE</div><nav className="nav-list">{nav.map(item=><button key={item.id} className={`nav-link ${page===item.id?'active':''}`} onClick={()=>navigate(item.id)}><item.icon size={19} strokeWidth={1.8}/>{item.title}{page===item.id&&<span className="active-dot"/>}</button>)}</nav><div className="sidebar-bottom"><div className="sidebar-help"><div className="help-icon"><BookOpen size={18}/></div><strong>Reporting made simple</strong><p>Record today. Understand the whole month.</p></div><button className="nav-link logout" onClick={logout}><LogOut size={18}/> Sign out</button></div></aside>{mobile&&<div className="mobile-overlay" onClick={()=>setMobile(false)}/>}<main className="main"><header className="topbar"><button className="menu-button" onClick={()=>setMobile(true)}><Menu size={23}/></button><div className="breadcrumb">Workspace <ChevronRight size={14}/> <strong>{title}</strong></div><div className="topbar-right"><span className="today-pill"><CalendarDays size={15}/>{fmt(overview?.today||ref?.today||new Date().toISOString())}</span><div className="user-avatar">{user.name.slice(0,1).toUpperCase()}</div><div className="user-meta"><strong>{user.name}</strong><small>{label(user.role)}</small></div></div></header><div className="content"><div className="page-heading"><div><div className="eyebrow">{overview?.organization|| (user.role==='SUPER_ADMIN'?'GLOBAL ADMINISTRATION':'SCHOOL WORKSPACE')}</div><h1>{title}</h1><p>{page==='overview'?`Welcome back, ${user.name.split(' ')[0]}. Here's what's happening in your school.`:page==='new'?'One class, one subject, one clear record of the day.':page==='monthly'?'Evidence-based insights from your daily records.':page==='manage'?'Keep your school structure up to date.':'Manage your school information with confidence.'}</p></div>{page==='overview'&&user.role==='TEACHER'&&<button className="btn primary" onClick={()=>startNew()}><Plus size={17}/> New report</button>}</div>{error&&<div className="message error"><AlertCircle size={18}/>{error}<button onClick={()=>setError('')}><X size={16}/></button></div>}{notice&&<div className="message success"><Check size={18}/>{notice}<button onClick={()=>setNotice('')}><X size={16}/></button></div>}
 {page==='overview'&&overview&&<><div className="welcome-banner"><div><span className="banner-kicker">YOUR SCHOOL AT A GLANCE</span><h2>{user.role==='TEACHER'?'Ready to make today count?':user.role==='SUPER_ADMIN'?'A clearer view of every school.':'Good morning. Great things are happening.'}</h2><p>{user.role==='TEACHER'?'Small daily observations create a complete picture of student growth.':user.role==='SUPER_ADMIN'?'Manage your organizations and support their success.':'Stay connected to your community, one report at a time.'}</p><button onClick={()=>navigate(user.role==='TEACHER'?'new':user.role==='SUPER_ADMIN'?'organizations':'reports')} className="banner-link">{user.role==='TEACHER'?'Create a report':user.role==='SUPER_ADMIN'?'View organizations':'Review reports'} <ChevronRight size={16}/></button></div><div className="banner-decoration"><div className="banner-circle"><GraduationCap size={75} strokeWidth={1.1}/></div></div></div>{user.role==='SUPER_ADMIN'?<div className="stats-grid"><Stat icon={School} label="Organizations" value={overview.organizations||0} tone="blue"/></div>:<><div className="section-top"><h2>Quick overview</h2><span className="section-caption">Live data from your workspace</span></div><div className="stats-grid"><Stat icon={GraduationCap} label="Students" value={overview.counts.students} tone="blue"/><Stat icon={Users} label="Teachers" value={overview.counts.teachers} tone="orange"/><Stat icon={School} label="Classes" value={overview.counts.classes} tone="green"/><Stat icon={ClipboardList} label="Reports recorded" value={Object.values(overview.counts.reports).reduce((a,b)=>a+b,0)} tone="purple"/></div>{user.role==='TEACHER'&&<><div className="section-top"><h2>My classes & subjects</h2><span className="section-caption">Your active teaching assignments</span></div>{teacherClasses.length?<div className="assignment-grid">{teacherClasses.map(cl=><div className="assignment-card" key={cl.classId}><div className="assignment-head"><span className="class-icon"><School size={21}/></span><span className="year-tag">{cl.yearName}</span></div><h3>Class {cl.className}</h3><p>{overview.assignments.filter(a=>a.classId===cl.classId).map(a=>a.subjectName).join(' · ')}</p><button onClick={()=>startNew(cl.classId,overview.assignments.find(a=>a.classId===cl.classId)?.subjectId)} className="card-action">New report <ChevronRight size={17}/></button></div>)}</div>:<Empty title="No assignments yet" detail="Ask your school administrator to assign you to a class and subject."/>}</>}{user.role==='ADMIN'&&<div className="mini-stats"><div><span>Drafts</span><strong>{overview.counts.reports.DRAFT||0}</strong></div><div><span>Submitted</span><strong>{overview.counts.reports.SUBMITTED||0}</strong></div><div><span>Approved</span><strong>{overview.counts.reports.APPROVED||0}</strong></div><div><span>Returned</span><strong>{overview.counts.reports.RETURNED||0}</strong></div></div>}<div className="section-top"><h2>Recent reports</h2><button className="inline-link" onClick={()=>navigate('reports')}>View all <ChevronRight size={16}/></button></div><div className="panel">{overview.recent.length?<div className="table-scroll"><table><thead><tr><th>LESSON DATE</th><th>CLASS & SUBJECT</th><th>TOPIC</th><th>STATUS</th><th></th></tr></thead><tbody>{overview.recent.map(r=><tr key={r.id}><td>{fmt(r.lessonDate)}</td><td><strong>{r.className}</strong><small>{r.subjectName}</small></td><td>{r.topic||'—'}</td><td><Badge status={r.status}/></td><td><button className="icon-link" onClick={()=>openLesson(r.id)}><ChevronRight size={18}/></button></td></tr>)}</tbody></table></div>:<Empty title="No reports yet" detail="Daily observations will appear here as they are recorded."/>}</div></>}</>}
 {page==='new'&&user.role==='TEACHER'&&<><div className="panel form-panel"><div className="panel-title"><div className="round-icon blue"><CalendarDays size={19}/></div><div><h2>Lesson details</h2><p>Choose when and where this lesson took place.</p></div>{existingStatus&&<Badge status={existingStatus}/>}</div>{existingStatus==='RETURNED'&&<div className="message warning">This report was returned. Review the administrator’s note in your report history, correct it and resubmit.</div>}<div className="form-grid"><label>Class<select value={selectedClass} disabled={!!lessonId} onChange={e=>{setSelectedClass(e.target.value);setSelectedSubject('');setRows({})}}><option value="">Select class</option>{teacherClasses.map(a=><option value={a.classId} key={a.classId}>{a.className}</option>)}</select></label><label>Subject<select value={selectedSubject} disabled={!!lessonId||!selectedClass} onChange={e=>setSelectedSubject(e.target.value)}><option value="">Select subject</option>{assignmentOptions.map(a=><option value={a.subjectId} key={a.id}>{a.subjectName}</option>)}</select></label><label>Lesson date<input type="date" value={date} min={ref?.minDate} max={ref?.today} disabled={!!lessonId} onChange={e=>setDate(e.target.value)}/><span className="field-hint">Allowed: {fmt(ref?.minDate||'')} – {fmt(ref?.today||'')}</span></label><label>Topic covered<input value={topic} maxLength={250} disabled={!!existingStatus&&!['DRAFT','RETURNED'].includes(existingStatus)} placeholder="e.g. Equivalent fractions" onChange={e=>setTopic(e.target.value)}/></label></div></div>{selectedClass&&<div className="panel roster-panel"><div className="panel-title roster-title"><div className="round-icon green"><Users size={19}/></div><div><h2>Student observations</h2><p>{students.length} active students in this class · Mark absent students too</p></div><button className="btn outline" onClick={()=>setRows(Object.fromEntries(students.map(s=>[s.id,normal(s.id)])))} disabled={!!existingStatus&&!['DRAFT','RETURNED'].includes(existingStatus)}><Check size={16}/> Set all normal</button></div>{students.length?<div className="student-list">{students.map((s,i)=>{const r=rows[s.id]||normal(s.id);const disabled=!!existingStatus&&!['DRAFT','RETURNED'].includes(existingStatus);return <div className="student-row" key={s.id}><div className="student-identity"><span className="student-number">{String(i+1).padStart(2,'0')}</span><div><strong>{s.fullName}</strong><small>{s.studentId}</small></div></div><div className="student-fields"><label>Attendance<select value={r.attendanceStatus} disabled={disabled} onChange={e=>changeRow(s.id,'attendanceStatus',e.target.value)}><option value="PRESENT">Present</option><option value="LATE">Late</option><option value="ABSENT">Absent</option></select></label>{r.attendanceStatus!=='ABSENT'&&<><label>Performance<select value={r.performance||''} disabled={disabled} onChange={e=>changeRow(s.id,'performance',e.target.value)}><option value="EXCELLENT">Excellent</option><option value="GOOD">Good</option><option value="NEEDS_IMPROVEMENT">Needs improvement</option></select></label><label>Participation<select value={r.participation||''} disabled={disabled} onChange={e=>changeRow(s.id,'participation',e.target.value)}><option value="ACTIVE">Active</option><option value="MODERATE">Moderate</option><option value="PASSIVE">Passive</option></select></label><label>Homework<select value={r.homework||''} disabled={disabled} onChange={e=>changeRow(s.id,'homework',e.target.value)}><option value="COMPLETED">Completed</option><option value="NOT_COMPLETED">Not completed</option><option value="NOT_APPLICABLE">Not applicable</option></select></label><label>Conduct<select value={r.conduct||''} disabled={disabled} onChange={e=>changeRow(s.id,'conduct',e.target.value)}><option value="EXCELLENT">Excellent</option><option value="GOOD">Good</option><option value="NEEDS_IMPROVEMENT">Needs improvement</option></select></label></>}</div>{r.attendanceStatus!=='ABSENT'&&<input className="comment-input" placeholder={(r.performance==='NEEDS_IMPROVEMENT'||r.conduct==='NEEDS_IMPROVEMENT')?'Comment required for improvement observations':'Optional comment for this student'} value={r.comment||''} maxLength={1000} disabled={disabled} onChange={e=>changeRow(s.id,'comment',e.target.value)}/>}</div>})}</div>:<Empty title="No active students" detail="This class has no active students in its roster."/>}</div>}{selectedClass&&students.length>0&&(!existingStatus||['DRAFT','RETURNED'].includes(existingStatus))&&<div className="report-footer"><div><strong>Submission summary</strong><span>{students.length} students · {Object.values(rows).filter(r=>r.attendanceStatus==='PRESENT').length} present · {Object.values(rows).filter(r=>r.attendanceStatus==='LATE').length} late · {Object.values(rows).filter(r=>r.attendanceStatus==='ABSENT').length} absent</span></div><div className="footer-actions"><button className="btn outline" disabled={busy} onClick={()=>save(false)}>Save draft</button><button className="btn primary" disabled={busy||!selectedSubject} onClick={()=>save(true)}>Submit class report <ChevronRight size={17}/></button></div></div>}</>}
 {page==='reports'&&user.role!=='SUPER_ADMIN'&&<div className="panel"><div className="list-toolbar"><div><h2>Report history</h2><p>Every lesson is filed by the date it took place.</p></div><button className="btn outline" onClick={()=>api('reports').then(d=>setReports(d.reports))}><RefreshCw size={16}/> Refresh</button></div>{reports.length?<div className="table-scroll"><table><thead><tr><th>LESSON DATE</th><th>CLASS / SUBJECT</th><th>TOPIC</th>{user.role==='ADMIN'&&<th>TEACHER</th>}<th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>{reports.map(r=><tr key={r.id}><td>{fmt(r.lessonDate)}</td><td><strong>{r.className}</strong><small>{r.subjectName}</small></td><td>{r.topic||'—'}{r.reviewComment&&<small className="return-note">Note: {r.reviewComment}</small>}</td>{user.role==='ADMIN'&&<td>{r.teacherName}</td>}<td><Badge status={r.status}/></td><td><div className="table-actions">{user.role==='TEACHER'?<><button className="inline-link" onClick={()=>openLesson(r.id)}>{['DRAFT','RETURNED'].includes(r.status)?'Continue':'View'} <ChevronRight size={15}/></button>{r.status==='DRAFT'&&<button className="tiny-button red" onClick={()=>run(async()=>{if(!window.confirm('Delete this draft and its student observations?'))return;await post('deleteDraft',{id:r.id});setReports((await api('reports')).reports);setNotice('Draft deleted.')})}>Delete</button>}</>:<><button className="tiny-button" onClick={()=>run(async()=>setReviewDetail(await api('lesson',{id:r.id})))}>Inspect</button>{r.status==='SUBMITTED'&&<button className="tiny-button" onClick={()=>review(r.id,'UNDER_REVIEW')}>Review</button>}{['SUBMITTED','UNDER_REVIEW'].includes(r.status)&&<>{r.status==='UNDER_REVIEW'&&<button className="tiny-button green" onClick={()=>review(r.id,'APPROVED')}>Approve</button>}<button className="tiny-button red" onClick={()=>review(r.id,'RETURNED')}>Return</button></>}{r.status==='APPROVED'&&<button className="tiny-button" onClick={()=>review(r.id,'SUBMITTED')}>Reopen</button>}</>}</div></td></tr>)}</tbody></table></div>:<Empty title="No reports yet" detail="Reports you create or review will appear here."/>}</div>}
 {page==='reports'&&user.role==='ADMIN'&&reviewDetail&&<div className="panel review-panel"><div className="list-toolbar"><div><div className="eyebrow">REPORT REVIEW</div><h2>{fmt(reviewDetail.lesson.lessonDate)} · {reviewDetail.lesson.topic}</h2><p>{reviewDetail.records.length} student observations · {reviewDetail.records.filter(r=>r.attendanceStatus==='PRESENT').length} present · {reviewDetail.records.filter(r=>r.attendanceStatus==='LATE').length} late · {reviewDetail.records.filter(r=>r.attendanceStatus==='ABSENT').length} absent</p></div><button className="icon-link" onClick={()=>setReviewDetail(null)}><X size={20}/></button></div><div className="table-scroll"><table><thead><tr><th>STUDENT</th><th>STUDENT ID</th><th>ATTENDANCE</th><th>PERFORMANCE</th><th>PARTICIPATION</th><th>HOMEWORK</th><th>CONDUCT</th><th>COMMENT</th></tr></thead><tbody>{reviewDetail.records.map(r=><tr key={r.studentId}><td><strong>{r.studentName||'Student'}</strong></td><td className="mono">{r.studentCode||r.studentId.slice(0,8)}</td><td>{label(r.attendanceStatus)}</td><td>{r.performance?label(r.performance):'—'}</td><td>{r.participation?label(r.participation):'—'}</td><td>{r.homework?label(r.homework):'—'}</td><td>{r.conduct?label(r.conduct):'—'}</td><td>{r.comment||'—'}</td></tr>)}</tbody></table></div><div className="review-actions"><button className="btn outline" onClick={()=>run(async()=>{const lessonDate=window.prompt('Correct lesson date (YYYY-MM-DD):',reviewDetail.lesson.lessonDate);if(!lessonDate||lessonDate===reviewDetail.lesson.lessonDate)return;const reason=window.prompt('Reason for date correction (at least 10 characters):');if(!reason)return;await post('correctLessonDate',{id:reviewDetail.lesson.id,lessonDate,reason});setReports((await api('reports')).reports);setReviewDetail(await api('lesson',{id:reviewDetail.lesson.id}));setNotice('Date corrected and recorded in the audit log.')})}>Correct date</button>{['SUBMITTED','UNDER_REVIEW'].includes(reviewDetail.lesson.status)&&<button className="btn outline" onClick={()=>review(reviewDetail.lesson.id,'RETURNED')}>Return with reason</button>}{reviewDetail.lesson.status==='SUBMITTED'&&<button className="btn primary" onClick={()=>review(reviewDetail.lesson.id,'UNDER_REVIEW')}>Start review <ChevronRight size={16}/></button>}{reviewDetail.lesson.status==='UNDER_REVIEW'&&<button className="btn primary" onClick={()=>review(reviewDetail.lesson.id,'APPROVED')}>Approve report <Check size={16}/></button>}</div></div>}
 {page==='students'&&user.role!=='SUPER_ADMIN'&&<div className="panel"><div className="list-toolbar"><div><h2>Student directory</h2><p>{user.role==='TEACHER'?'Students in your assigned classes':'Search and manage your school roster'}</p></div>{user.role==='ADMIN'&&<button className="btn primary" onClick={()=>{setEntity('student');navigate('manage')}}><Plus size={16}/> Add student</button>}</div><div className="filters">{user.role==='TEACHER'&&<select value={selectedClass} onChange={e=>{setSelectedClass(e.target.value);setStudentPage(0)}}><option value="">Select an assigned class</option>{teacherClasses.map(a=><option key={a.classId} value={a.classId}>{a.className}</option>)}</select>}<div className="search-box"><Search size={17}/><input placeholder="Search by name or student ID" value={search} onChange={e=>{setSearch(e.target.value);setStudentPage(0)}}/></div></div>{students.length?<div className="table-scroll"><table><thead><tr><th>STUDENT</th><th>STUDENT ID</th><th>CLASS</th><th>STATUS</th></tr></thead><tbody>{students.map(s=><tr key={s.id}><td>{user.role==='ADMIN'?<button className="inline-link" onClick={()=>run(async()=>setStudentProfile(await api('studentProfile',{id:s.id})))}>{s.fullName} <ChevronRight size={14}/></button>:<strong>{s.fullName}</strong>}</td><td>{s.studentId}</td><td>{s.className}</td><td><Badge status={s.status}/>{user.role==='TEACHER'&&<button className="tiny-button" style={{marginLeft:8}} onClick={()=>run(async()=>{const category=window.prompt('Category (Behaviour, Academic, Homework, Participation, Punctuality, Other):','Behaviour');if(!category)return;const severity=window.prompt('Severity (LOW, MODERATE, HIGH):','LOW');if(!severity)return;const description=window.prompt('Describe the significant observation:');if(!description)return;await post('observation',{studentId:s.id,classId:s.classId,date:ref?.today,category,severity:severity.toUpperCase(),description,followUpRequired:window.confirm('Is follow-up required?')});setNotice('Significant observation saved.')})}>Add observation</button>}</td></tr>)}</tbody></table></div>:<Empty title="No students to show" detail={user.role==='TEACHER'?'Select an assigned class to view its students.':'Add students through school setup to build your roster.'}/>}<div className="directory-pager"><button className="btn outline" disabled={studentPage===0} onClick={()=>setStudentPage(p=>p-1)}>Previous</button><span>Page {studentPage+1}</span><button className="btn outline" disabled={!studentsHasMore} onClick={()=>setStudentPage(p=>p+1)}>Next</button></div></div>}
 {page==='students'&&user.role==='ADMIN'&&studentProfile&&<section className="panel review-panel"><div className="list-toolbar"><div><div className="eyebrow">STUDENT PROFILE</div><h2>{studentProfile.student.fullName}</h2><p>{studentProfile.student.studentId} · Class {studentProfile.student.className} · {studentProfile.timeline.length} recent records</p></div><button className="icon-link" onClick={()=>setStudentProfile(null)} aria-label="Close student profile"><X size={20}/></button></div>{studentProfile.timeline.length?<div className="table-scroll"><table><thead><tr><th>LESSON DATE</th><th>SUBJECT / TOPIC</th><th>ATTENDANCE</th><th>PERFORMANCE</th><th>PARTICIPATION</th><th>HOMEWORK</th><th>CONDUCT</th><th>COMMENT</th></tr></thead><tbody>{studentProfile.timeline.map((r,i)=><tr key={i}><td>{fmt(r.lessonDate)}</td><td><strong>{r.subject}</strong><small>{r.topic}</small></td><td>{label(r.attendance)}</td><td>{r.performance?label(r.performance):'—'}</td><td>{r.participation?label(r.participation):'—'}</td><td>{r.homework?label(r.homework):'—'}</td><td>{r.conduct?label(r.conduct):'—'}</td><td>{r.comment||'—'}</td></tr>)}</tbody></table></div>:<Empty title="No daily records" detail="No observations have been recorded for this student yet."/>}<div className="detail-notes" style={{padding:20}}><h3>Significant observations</h3>{studentProfile.significant.length?studentProfile.significant.map(o=><p key={o.id}><strong>{fmt(o.date)} · {o.category} · {label(o.severity)}</strong> {o.description}{o.followUpRequired?' · Follow-up required':''}</p>):<p>No separate significant observations recorded.</p>}</div></section>}
 {['monthly','statistics'].includes(page)&&user.role!=='SUPER_ADMIN'&&<><div className="panel form-panel"><div className="panel-title"><div className="round-icon purple"><BarChart3 size={19}/></div><div><h2>Build a monthly report</h2><p>Calculated from submitted daily observations by lesson date.</p></div></div><div className="report-filters"><label>Month<input type="month" value={monthlyMonth} onChange={e=>setMonthlyMonth(e.target.value)}/></label><label>Class<select value={monthlyClass} onChange={e=>{const cid=e.target.value;setMonthlyClass(cid);setMonthlySubject('');setMonthlyStudent('');if(cid){api('students',{classId:cid,roster:'1'}).then(d=>setClassStudents(d.students)).catch(()=>setClassStudents([]));}else{setClassStudents([]);}}}><option value="">{user.role==='TEACHER'?'Select class':'All classes'}</option>{(user.role==='TEACHER'?teacherClasses.map(c=>({id:c.classId,name:c.className})):ref?.classes||[]).map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</select></label><label>Subject<select value={monthlySubject} onChange={e=>setMonthlySubject(e.target.value)}><option value="">{user.role==='TEACHER'?'Select subject':'All subjects'}</option>{user.role==='TEACHER'?(overview?.assignments||[]).filter(a=>a.classId===monthlyClass).map(a=><option key={a.id} value={a.subjectId}>{a.subjectName}</option>):(ref?.subjects||[]).map(s=><option key={s.id} value={s.id}>{s.name}</option>)}</select></label>{monthlyClass&&classStudents.length>0&&<label>Student<select value={monthlyStudent} onChange={e=>setMonthlyStudent(e.target.value)}><option value="">All students in class</option>{classStudents.map(s=><option key={s.id} value={s.id}>{s.fullName} ({s.studentId})</option>)}</select></label>}{user.role==='ADMIN'&&<><label>Academic year<select value={monthlyYear} onChange={e=>{setMonthlyYear(e.target.value);setMonthlyTerm('')}}><option value="">All years</option>{ref?.years.map(y=><option key={y.id} value={y.id}>{y.name}</option>)}</select></label><label>Term<select value={monthlyTerm} onChange={e=>setMonthlyTerm(e.target.value)}><option value="">All terms</option>{ref?.terms.filter(t=>!monthlyYear||t.academicYearId===monthlyYear).map(t=><option key={t.id} value={t.id}>{t.name}</option>)}</select></label><label>Grade<select value={monthlyGrade} onChange={e=>setMonthlyGrade(e.target.value)}><option value="">All grades</option>{ref?.grades.map(g=><option key={g.id} value={g.id}>{g.name}</option>)}</select></label><label>Teacher<select value={monthlyTeacher} onChange={e=>setMonthlyTeacher(e.target.value)}><option value="">All teachers</option>{ref?.teachers.map(t=><option key={t.id} value={t.id}>{t.name}</option>)}</select></label></>}<button className="btn primary" disabled={busy||!monthlyMonth||(user.role==='TEACHER'&&(!monthlyClass||!monthlySubject))} onClick={getMonthly}>Generate report <ChevronRight size={16}/></button></div></div>{monthly&&<div className="panel monthly-panel"><div className="list-toolbar"><div><div className="eyebrow">{monthly.organization.toUpperCase()} · {monthly.month}</div><h2>Monthly student follow-up</h2><p>{monthly.summaries.length} student-subject summaries · Based only on recorded lessons</p></div><div className="export-actions"><button className="btn outline" onClick={()=>window.print()}><Printer size={16}/> Print / PDF</button><button className="btn outline" onClick={()=>exportMonthly('xlsx')}><Download size={16}/> Excel</button><button className="btn outline" onClick={()=>exportMonthly('csv')}><Download size={16}/> CSV</button></div></div>{monthly.summaries.length?<><div className="table-scroll"><table><thead><tr><th>STUDENT</th><th>CLASS</th><th>SUBJECT</th><th>LESSONS</th><th>P / L / A</th><th>PERFORMANCE</th><th>HOMEWORK</th><th></th></tr></thead><tbody>{monthly.summaries.map(s=><tr key={`${s.studentId}-${s.subjectName}`}><td><strong>{s.studentName}</strong><small>{s.studentCode}</small></td><td>{s.className}</td><td>{s.subjectName}</td><td>{s.lessons}</td><td>{s.attendance.PRESENT||0} / {s.attendance.LATE||0} / {s.attendance.ABSENT||0}</td><td>{label(s.performanceResult)}</td><td>{s.homeworkResult}</td><td><button className="inline-link" onClick={()=>setSelectedSummary(s)}>Details <ChevronRight size={15}/></button></td></tr>)}</tbody></table></div>{selectedSummary&&<div className="report-detail"><div className="detail-heading"><div><div className="eyebrow">STUDENT SUBJECT REPORT</div><h2>{selectedSummary.studentName} <span>· {selectedSummary.subjectName}</span></h2><p>{selectedSummary.className} · {monthly.month} · {selectedSummary.lessons} recorded lessons · Calculation v{selectedSummary.version}</p></div><button onClick={()=>setSelectedSummary(null)} className="icon-link"><X size={20}/></button></div><div className="detail-metrics"><Metric title="Performance" result={label(selectedSummary.performanceResult)} counts={selectedSummary.performance}/><Metric title="Participation" result={label(selectedSummary.participationResult)} counts={selectedSummary.participation}/><Metric title="Homework" result={selectedSummary.homeworkResult} counts={selectedSummary.homework}/><Metric title="Conduct" result={label(selectedSummary.conductResult)} counts={selectedSummary.conduct}/></div><div className="detail-bottom"><div><h3>Attendance</h3><p>Present {selectedSummary.attendance.PRESENT||0} · Late {selectedSummary.attendance.LATE||0} · Absent {selectedSummary.attendance.ABSENT||0}</p><strong>{selectedSummary.attendanceRate??'—'}% attendance · {selectedSummary.punctualityResult}</strong></div><div><h3>Topics covered</h3><p>{selectedSummary.topics.join(' · ')||'No topics recorded'}</p></div></div>{selectedSummary.observations.length>0&&<div className="detail-notes"><h3>Important observations</h3>{selectedSummary.observations.map((o,i)=><p key={i}><strong>{fmt(o.date)}</strong> {o.comment}</p>)}</div>}</div>}</>:<Empty title="No records available for this reporting period" detail="Try another month or class. Monthly reports are based on submitted daily records."/>}</div>}</>}
 {['monthly','statistics'].includes(page)&&monthly&&<MonthlyOverview month={monthly.month} school={monthly.organization} summaries={monthly.summaries} data={monthly.data} rules={monthly.rules}/>}
 {page==='import'&&user.role==='ADMIN'&&<div className="panel form-panel"><div className="panel-title"><div className="round-icon blue"><Download size={19}/></div><div><h2>Import school data</h2><p>Preview first. Validate and confirm before records are saved. CSV and XLSX · 2 MB · 300 rows.</p></div></div><div className="form-grid"><label>Data type<select value={importKind} onChange={e=>{setImportKind(e.target.value as typeof importKind);setImportRows([]);setImportResult(null)}}><option value="students">Students</option><option value="teachers">Teachers</option><option value="assignments">Teacher assignments</option></select></label><label>Spreadsheet<input type="file" accept=".csv,.xlsx" onChange={e=>{const file=e.target.files?.[0];if(file)parseImport(file)}}/></label></div><p className="muted" style={{marginTop:15,fontSize:12}}>Expected columns: {importFields[importKind].join(' · ')}</p>{importRows.length>0&&<><div className="section-top"><h2>Map columns</h2><span className="section-caption">{importRows.length} rows ready for validation</span></div><div className="form-grid">{importFields[importKind].map(k=><label key={k}>{k}<select value={mapping[k]||''} onChange={e=>setMapping({...mapping,[k]:e.target.value})}><option value="">Not mapped</option>{importHeaders.map(h=><option key={h} value={h}>{h}</option>)}</select></label>)}</div><div className="section-top"><h2>Preview</h2></div><div className="table-scroll"><table><thead><tr>{importFields[importKind].map(k=><th key={k}>{k.toUpperCase()}</th>)}</tr></thead><tbody>{importRows.slice(0,5).map((r,i)=><tr key={i}>{importFields[importKind].map(k=><td key={k}>{r[mapping[k]]||'—'}</td>)}</tr>)}</tbody></table></div><div style={{marginTop:20}}><button className="btn primary" disabled={busy} onClick={confirmImport}>Confirm & import {importRows.length} rows <ChevronRight size={16}/></button></div></>}{importResult&&<div className="import-results"><h2>Import results</h2><p>Imported: {importResult.imported} · Updated: {importResult.updated} · Errors: {importResult.skipped}</p>{importResult.errors.length>0&&<button className="btn outline" onClick={downloadErrors}><Download size={15}/> Download error CSV</button>}{importResult.credentials.length>0&&<div className="message warning">New teacher initial credentials (shown once): {importResult.credentials.map(x=>`${x.email}: ${x.password}`).join(' · ')}. Share securely and ask teachers to change passwords.</div>}</div>}</div>}
 {page==='manage'&&user.role==='ADMIN'&&ref&&<><div className="management-tabs">{['year','term','grade','class','subject','teacher','assignment','student'].map(t=><button key={t} className={entity===t?'selected':''} onClick={()=>{setEntity(t);setForm({})}}>{label(t)}{t==='class'||t==='subject'||t==='teacher'?'s':''}</button>)}</div><div className="manage-layout"><div className="panel form-panel"><div className="panel-title"><div className="round-icon blue"><Plus size={20}/></div><div><h2>Add {label(entity).toLowerCase()}</h2><p>New entries are scoped to your school.</p></div></div><form onSubmit={e=>{e.preventDefault();create()}} className="manage-form">{(fieldMap[entity]||[]).map(f=><label key={f.key}>{f.label}{f.options?<select required value={form[f.key]||''} onChange={e=>setForm({...form,[f.key]:e.target.value})}><option value="">Select {f.label.toLowerCase()}</option>{(f.options==='years'?ref.years:f.options==='grades'?ref.grades:f.options==='classes'?ref.classes:f.options==='subjects'?ref.subjects:ref.teachers).map(o=><option key={o.id} value={o.id}>{o.name}</option>)}</select>:<input required={f.key!=='department'} type={f.type||'text'} minLength={f.key==='password'?12:undefined} value={form[f.key]||''} placeholder={f.placeholder||''} onChange={e=>setForm({...form,[f.key]:e.target.value})}/>}</label>)}<button disabled={busy} className="btn primary wide"><Plus size={16}/> Create {label(entity).toLowerCase()}</button></form></div><div className="panel reference-panel"><div className="list-toolbar"><div><h2>Current {label(entity).toLowerCase()}s</h2><p>Active records in your organization</p></div></div><div className="reference-list">{(entity==='year'?ref.years:entity==='term'?ref.terms:entity==='grade'?ref.grades:entity==='class'?ref.classes:entity==='subject'?ref.subjects:entity==='teacher'?ref.teachers:entity==='assignment'?ref.assignments:students).slice(0,50).map((x,i)=><div className="reference-item" key={x.id}><span className="reference-index">{String(i+1).padStart(2,'0')}</span><strong>{'name' in x?x.name:'fullName' in x?x.fullName:entity==='assignment'?`${ref.teachers.find(t=>t.id===(x as Ref['assignments'][number]).teacherId)?.name||'Teacher'} · ${ref.classes.find(c=>c.id===(x as Ref['assignments'][number]).classId)?.name||'Class'} · ${ref.subjects.find(s=>s.id===(x as Ref['assignments'][number]).subjectId)?.name||'Subject'}`:'Entry'}</strong><span>{'code' in x?String(x.code):''}</span>{entity==='teacher'&&'active' in x&&<button className="tiny-button" disabled={busy} onClick={()=>run(async()=>{const active=!!x.active;if(!window.confirm(`${active?'Deactivate':'Activate'} this teacher?`))return;await post('teacherAccess',{teacherId:x.id,active:!active});setRef(await api('reference'));setNotice('Teacher access updated.')})}>{x.active?'Deactivate':'Activate'}</button>}</div>)}{entity==='student'&&<p className="muted pad">Student directory is available under Students.</p>}</div></div></div></>}
 {page==='organizations'&&user.role==='SUPER_ADMIN'&&<><div className="manage-layout"><div className="panel form-panel"><div className="panel-title"><div className="round-icon blue"><Plus size={20}/></div><div><h2>Create organization</h2><p>Start a new independent school workspace.</p></div></div><form className="manage-form" onSubmit={e=>{e.preventDefault();run(async()=>{await post('organization',form);setNotice('Organization created. Create its admin next.');setForm({});setOrganizations((await api('organizations')).organizations)})}}><label>School name<input required value={form.name||''} onChange={e=>setForm({...form,name:e.target.value})}/></label><label>Code<input required value={form.code||''} onChange={e=>setForm({...form,code:e.target.value})}/></label><label>Timezone<input required value={form.timezone||'Africa/Bujumbura'} onChange={e=>setForm({...form,timezone:e.target.value})}/></label><label>Domain (optional)<input value={form.domain||''} placeholder="e.g. school.org" onChange={e=>setForm({...form,domain:e.target.value})}/></label><label>Logo URL (optional)<input value={form.logoUrl||''} placeholder="https://..." onChange={e=>setForm({...form,logoUrl:e.target.value})}/></label><button className="btn primary wide" disabled={busy}>Create organization</button></form></div><div className="panel"><div className="list-toolbar"><div><h2>Organizations</h2><p>{organizations.length} independent school workspaces</p></div></div><div className="org-list">{organizations.map(o=><div className="org-item" key={o.id}><div className="org-icon"><School size={22}/></div><div className="org-info"><strong>{o.name}</strong><span>{o.code} · {o.timezone}</span><small>{o.studentCount} students · {o.teacherCount} teachers · {o.classCount} classes</small></div><Badge status={o.active?'ACTIVE':'INACTIVE'}/><button className="tiny-button" onClick={()=>run(async()=>{const name=window.prompt('School name:',o.name);if(!name)return;const code=window.prompt('Organization code:',o.code);if(!code)return;const timezone=window.prompt('IANA timezone:',o.timezone);if(!timezone)return;await post('organization',{id:o.id,name,code,timezone,active:o.active});setOrganizations((await api('organizations')).organizations);setNotice('Organization updated.')})}>Edit</button><button className="tiny-button" onClick={()=>{setForm({organizationId:o.id});setEntity('admin')}}>Admin</button>{o.primaryAdminUserId&&<button className="tiny-button" onClick={()=>run(async()=>{const password=window.prompt(`New administrator password for ${o.name} (12+ characters):`);if(!password)return;await post('resetAdmin',{organizationId:o.id,password});setNotice('Administrator access reset. Share the new password securely.')})}>Reset access</button>}<button className="tiny-button" onClick={()=>run(async()=>{await post('organization',{id:o.id,name:o.name,code:o.code,timezone:o.timezone,active:!o.active});setOrganizations((await api('organizations')).organizations)})}>{o.active?'Deactivate':'Activate'}</button></div>)}</div></div></div>{entity==='admin'&&<div className="panel form-panel admin-create"><div className="panel-title"><div className="round-icon purple"><ShieldCheck size={19}/></div><div><h2>Create organization administrator</h2><p>Assign access to the selected organization.</p></div><button className="icon-link" onClick={()=>setEntity('student')}><X size={18}/></button></div><form className="manage-form" onSubmit={e=>{e.preventDefault();run(async()=>{await post('admin',form);setNotice('Administrator created. Share credentials securely.');setForm({});setEntity('student');setOrganizations((await api('organizations')).organizations)})}}><label>Organization<select required value={form.organizationId||''} onChange={e=>setForm({...form,organizationId:e.target.value})}>{organizations.map(o=><option key={o.id} value={o.id}>{o.name}</option>)}</select></label>{['name','username','email','password'].map(k=><label key={k}>{label(k)}<input required type={k==='password'?'password':k==='email'?'email':'text'} minLength={k==='password'?12:undefined} value={form[k]||''} onChange={e=>setForm({...form,[k]:e.target.value})}/></label>)}<button className="btn primary" disabled={busy}>Create administrator</button></form></div>}</>}
 {page==='settings'&&user.role==='ADMIN'&&config&&<div className="manage-layout"><div className="panel form-panel"><div className="panel-title"><div className="round-icon purple"><Settings size={19}/></div><div><h2>Reporting rules</h2><p>Version {config.settings.version} · Changes affect future calculations.</p></div></div><form className="manage-form" onSubmit={e=>{e.preventDefault();run(async()=>{await post('settings',{timezone:form.timezone||config.organization.timezone,excellentThreshold:form.excellentThreshold||config.settings.excellentThreshold,goodThreshold:form.goodThreshold||config.settings.goodThreshold,homeworkUsuallyThreshold:form.homeworkUsuallyThreshold||config.settings.homeworkUsuallyThreshold,punctualityOccasionallyMax:form.punctualityOccasionallyMax||config.settings.punctualityOccasionallyMax});setNotice('Settings saved.');setConfig(await api('settings'));setForm({})})}}>{([['timezone','School timezone',config.organization.timezone],['excellentThreshold','Excellent score threshold',config.settings.excellentThreshold],['goodThreshold','Good score threshold',config.settings.goodThreshold],['homeworkUsuallyThreshold','Homework usually threshold (0–1)',config.settings.homeworkUsuallyThreshold],['punctualityOccasionallyMax','Occasionally late max rate (0–1)',config.settings.punctualityOccasionallyMax]] as [string,string,string|number][]).map(([key,name,value])=><label key={key}>{name}<input type={key==='timezone'?'text':'number'} step="any" value={form[key]??String(value)} onChange={e=>setForm({...form,[key]:e.target.value})}/></label>)}<button className="btn primary" disabled={busy}>Save settings</button></form></div><div className="panel form-panel"><div className="panel-title"><div className="round-icon orange"><CalendarDays size={19}/></div><div><h2>Month closing</h2><p>Prevent new teacher edits in closed months.</p></div></div><div className="manage-form"><label>Reporting month<input type="month" value={monthlyMonth} onChange={e=>setMonthlyMonth(e.target.value)}/></label><p className="muted">{config.closures.find(c=>c.month===monthlyMonth)?.closed?'This month is closed.':'This month is open.'}</p><button className="btn outline" onClick={()=>run(async()=>{await post('month',{month:monthlyMonth,closed:!config.closures.find(c=>c.month===monthlyMonth)?.closed});setConfig(await api('settings'));setNotice('Month status updated.')})}>{config.closures.find(c=>c.month===monthlyMonth)?.closed?'Reopen month':'Close month'}</button></div><div className="divider"/><div className="panel-title"><div className="round-icon blue"><LockKeyhole size={19}/></div><div><h2>Change password</h2><p>Signing out is required after changing it.</p></div></div><div className="manage-form"><label>Current password<input type="password" value={pass.current} onChange={e=>setPass({...pass,current:e.target.value})}/></label><label>New password (12+ characters)<input type="password" value={pass.password} onChange={e=>setPass({...pass,password:e.target.value})}/></label><button className="btn outline" onClick={()=>run(async()=>{const r=await fetch('/api/auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'password',...pass})});const d=await r.json();if(!r.ok)throw Error(d.error);setUser(null);navigate('overview')})}>Update password</button></div></div></div>}
 {page==='audit'&&['ADMIN','SUPER_ADMIN'].includes(user.role)&&<div className="panel"><div className="list-toolbar"><div><h2>Activity history</h2><p>Recent actions in your organization</p></div></div>{auditLogs.length?<div className="table-scroll"><table><thead><tr><th>WHEN</th><th>ACTION</th><th>ENTITY</th><th>REFERENCE</th></tr></thead><tbody>{auditLogs.map(l=><tr key={l.id}><td>{new Date(l.createdAt).toLocaleString()}</td><td><strong>{label(l.action)}</strong></td><td>{label(l.entityType)}</td><td className="mono">{l.entityId?.slice(0,12)||'—'}</td></tr>)}</tbody></table></div>:<Empty title="No activity yet" detail="Important actions are recorded here."/>}</div>}
 </div></main></div>;
}
function Stat({icon:Icon,label,value,tone}:{icon:typeof School;label:string;value:number;tone:string}){return <div className="stat-card"><div className={`stat-icon ${tone}`}><Icon size={22} strokeWidth={1.8}/></div><span>{label}</span><strong>{value.toLocaleString()}</strong><div className="stat-foot"><span className="live-dot"/> Live count</div></div>}
function Metric({title,result,counts}:{title:string;result:string;counts:Record<string,number>}){return <div className="metric"><span>{title}</span><strong>{result}</strong><small>{Object.entries(counts).map(([k,v])=>`${label(k)}: ${v}`).join(' · ')||'No observations'}</small></div>}
const importFields:Record<'students'|'teachers'|'assignments',string[]>={students:['Student ID','Student Name','Grade','Class','Academic Year','Status'],teachers:['Teacher ID','Teacher Name','Email','Department'],assignments:['Teacher Email','Class','Subject','Academic Year','Active']};
const fieldMap:Record<string,{key:string;label:string;type?:string;options?:string;placeholder?:string}[]>={year:[{key:'name',label:'Academic year',placeholder:'2026-2027'},{key:'startDate',label:'Start date',type:'date'},{key:'endDate',label:'End date',type:'date'}],term:[{key:'name',label:'Term name',placeholder:'Term 1'},{key:'academicYearId',label:'Academic year',options:'years'},{key:'startDate',label:'Start date',type:'date'},{key:'endDate',label:'End date',type:'date'}],grade:[{key:'name',label:'Grade name',placeholder:'Grade 7'},{key:'orderIndex',label:'Display order',type:'number'}],class:[{key:'name',label:'Class name',placeholder:'7A'},{key:'gradeId',label:'Grade',options:'grades'},{key:'academicYearId',label:'Academic year',options:'years'}],subject:[{key:'name',label:'Subject name',placeholder:'Mathematics'},{key:'code',label:'Subject code',placeholder:'MATH'}],teacher:[{key:'teacherId',label:'Teacher ID'},{key:'name',label:'Full name'},{key:'email',label:'Email',type:'email'},{key:'department',label:'Department (optional)'},{key:'username',label:'Login username'},{key:'password',label:'Initial password (12+ characters)',type:'password'}],assignment:[{key:'teacherId',label:'Teacher',options:'teachers'},{key:'classId',label:'Class',options:'classes'},{key:'subjectId',label:'Subject',options:'subjects'},{key:'academicYearId',label:'Academic year',options:'years'}],student:[{key:'studentId',label:'Student ID'},{key:'firstName',label:'First name'},{key:'lastName',label:'Last name'},{key:'gradeId',label:'Grade',options:'grades'},{key:'classId',label:'Class',options:'classes'},{key:'academicYearId',label:'Academic year',options:'years'}]};
